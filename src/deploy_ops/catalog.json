      "adapters": [
        "directory",
        "static"
      ],
      "command": "deploy-ops init DIRECTORY"
    },
    {
      "id": "saved-iac",
      "kind": "integration",
      "status": "contract-tested",
      "providers": [
        "aws",
        "azure",
        "gcp",
        "local"
      ],
      "adapters": [
        "opentofu",
        "terraform"
      ],
      "boundary": "Cloud IaC uses the separate plan/apply gate workflow"
    },
