# Dockerfile - Run one controller as an unprivileged process with persistent local state.


# Use the supported Python runtime without development tooling
FROM python:3.13-slim

# Keep logs immediate and generated bytecode outside the image filesystem
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# Resolve tested runtime versions separately from the project's own source
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Include the product and its required notices without private workspace state
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY licenses ./licenses
COPY src ./src

# Install without resolving new dependencies and prepare writable state
RUN pip install --no-cache-dir --no-deps . \
    && mkdir /state \
    && chown -R 10001:10001 /app /state

# Drop root before starting the controller
USER 10001:10001
EXPOSE 8787

# Read operator configuration from the explicitly mounted configuration directory
CMD ["deploy-ops", "gate", "serve", "--config", "/config/controller.toml", "--host", "0.0.0.0"]
