*.py[cod]
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.state/
.deploy_ops/
.deploy-ops/
.env
.env.*
!.env.example
config/controller.toml
*.db
*.db-shm
*.db-wal
*.sqlite*
*.tfstate*
*.tfplan
*.plan
plan.bin
plan.json
*.lease.json
lease.json
proposal.json
*.pem
*.key
*.token
.terraform/
terraform.tfvars
*.auto.tfvars
.DS_Store
